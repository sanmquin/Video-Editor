# StudioCut Environment Variables Setup
# Copy this file to .env for local development

# Google Gemini API Key
# Optional: Required for Gemini 3.1 Flash Lite AI Hook Finder feature.
# If omitted, the application uses an intelligent built-in rule-based fallback algorithm.
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube OAuth 2.0 Client Credentials
# Optional: Required for connecting real YouTube channel analytics.
# If omitted, StudioCut runs with realistic demo dataset mode.
YOUTUBE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_google_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:5173/auth/callback

# Server Port (for standalone Node server)
PORT=3000
